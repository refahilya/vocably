# --- Secrets & environment ---
.env

# --- Dart / Flutter build artifacts ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/doc/api/

# --- IDE (machine-specific project files) ---
*.iml
*.ipr
*.iws
.idea/
# .vscode/ intentionally NOT ignored — shared editor/launch config is fine to track.

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Misc ---
*.log
migrate_working_dir/

# --- Vocab import pipeline (tools/vocab_import/, dev-side only) ---
# Moved here from the old /data/oxford/ location during Milestone 4.
/tools/vocab_import/node_modules/
/tools/vocab_import/input/*.csv
/tools/vocab_import/output/

# --- Research instrument tooling (tools/research/, dev-side only) ---
# The private answer key (*.private.json) and the extraction comparison
# report (*.private.md) contain correct answers. build_instrument.js refuses
# to write them inside this repository, inside any Git working tree or
# inside OneDrive at all; these patterns are a second line of defence in
# case one is ever copied in by hand.
*.private.json
*.private.md
/tools/research/node_modules/
# Researcher audit logs (tools/research/bin/research_admin.js --log). The tool
# refuses paths inside this repository; this is a second line of defence.
*.private.jsonl
