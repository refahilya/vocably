rules_version = '2';

// Milestone 2: real users/teacherAccessCodes rules. Field matrix and
// exact rationale for every clause below were reviewed and approved
// against DATA_MODEL.md §1 before this was written — see project chat
// history for the field-by-field justification.
//
// Milestone 4 Stage 2: read-only vocabWords/topics access for any
// signed-in user (DATA_MODEL.md §2/§2b — "read-only total untuk siswa").
// Guru write access (Tambah Kosakata / Edit Kata) is deliberately NOT
// implemented here — that lands in Milestone 5 with the actual guru
// vocabulary-management feature.
//
// Every other collection still defaults to deny-all (untouched Milestone 1
// baseline) since no other schema exists yet.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Milestone 5 (DATA_MODEL.md §5's already-documented pattern, reused
    // here for vocabWords/topics): role-gates guru-only writes via a
    // get() on the caller's own users/{uid} doc — not a second write
    // permission, so this doesn't need vocabWords/topics to grant `read`
    // on `users` themselves (get()/exists() bypass read rules, §1).
    function isGuru() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guru';
    }

    function isValidStudentCreate() {
      let data = request.resource.data;
      return data.role == 'siswa'
        && data.cefrLevel == null
        && data.placementTestCompleted == false
        && data.placementTestPrompted == false
        && data.keys().hasOnly([
             'uid', 'email', 'name', 'role', 'createdAt',
             'cefrLevel', 'placementTestCompleted', 'placementTestPrompted'
           ]);
    }

    function isValidTeacherCreate() {
      let data = request.resource.data;
      return data.role == 'guru'
        && data.teacherCodeInput is string
        && data.teacherCodeInput.size() > 0
        && exists(/databases/$(database)/documents/teacherAccessCodes/$(data.teacherCodeInput))
        && get(/databases/$(database)/documents/teacherAccessCodes/$(data.teacherCodeInput)).data.active == true
        && data.keys().hasOnly([
             'uid', 'email', 'name', 'role', 'createdAt', 'teacherCodeInput'
           ]);
    }

    // The official level follows only a placement attempt of this user
    // scored in the same batch (learning or research — `DATA_MODEL.md` §1).
    function validPlacementResultOnUser(uid) {
      let after = request.resource.data;
      let a = getAfter(/databases/$(database)/documents/placementAttempts/$(after.resultAttemptId)).data;
      return after.diff(resource.data).affectedKeys()
               .hasOnly(['resultLevel', 'resultAttemptId', 'placementTestCompleted'])
        && after.resultAttemptId is string
        && a.studentId == uid && a.status == 'scored' && a.scoredAt == request.time
        && after.resultLevel == a.resultLevel
        && after.placementTestCompleted == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.createdAt == request.time
        && (isValidStudentCreate() || isValidTeacherCreate());

      // Role-specific self-update whitelists — siswa may update `name`,
      // `cefrLevel` (legacy display field, never used for research) and
      // `placementTestPrompted`; guru may only update `name`. uid/email/
      // role/createdAt/teacherCodeInput are immutable for both roles: they
      // simply never appear in either whitelist below, so any attempt to
      // touch them fails hasOnly() and the whole update is denied.
      // Placement PT-V1.1: `resultLevel`/`resultAttemptId`/
      // `placementTestCompleted` change only together with a placement
      // attempt scored in this same batch (`validPlacementResultOnUser`).
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && (
          (resource.data.role == 'siswa'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name', 'cefrLevel', 'placementTestPrompted']))
          ||
          (resource.data.role == 'siswa' && validPlacementResultOnUser(uid))
          ||
          (resource.data.role == 'guru'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['name']))
        );

      allow delete: if false;
    }

    match /teacherAccessCodes/{code} {
      allow read, write: if false;
    }

    // Milestone 4 Stage 2 / Milestone 5 (DATA_MODEL.md §2): bank kosakata
    // master data. Read-only for every signed-in user — no role check on
    // read, since nothing in the docs restricts it to siswa specifically.
    //
    // Write: guru only, via `set()` from the client (no `create()` on the
    // client SDK — DATA_MODEL.md §2's note on why `create`/`update` here
    // is what actually distinguishes a brand-new docId from an existing
    // one, not application code). Two entirely separate shapes are
    // allowed, matching the two guru flows §2 documents — no per-element
    // array validation anywhere (`CLAUDE.md` §6's explicit rule against
    // that; only outer-field shape is checked):
    //   (a) `create` — a brand-new word ("Tambah Kosakata", Milestone 5).
    //   (b) `update` — either append a new meaning (`meanings`/`posList`,
    //       Milestone 5) or edit `topics` (Milestone 8's "Edit Kata" —
    //       the rule is added now since DATA_MODEL.md §2 documents both
    //       update shapes together as one pair; no client calls the
    //       topics-only shape until that milestone builds the UI for it).
    match /vocabWords/{wordId} {
      allow read: if request.auth != null;

      allow create: if isGuru()
        && wordId == request.resource.data.word
        && request.resource.data.source == 'guru'
        && request.resource.data.addedByTeacherId == request.auth.uid
        && request.resource.data.meanings is list
        && request.resource.data.meanings.size() > 0
        && request.resource.data.posList is list
        && request.resource.data.cefrLevel is string
        && request.resource.data.topics is list
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
             'word', 'meanings', 'posList', 'cefrLevel', 'topics',
             'source', 'addedByTeacherId', 'createdAt', 'updatedAt'
           ]);

      allow update: if isGuru()
        && request.resource.data.updatedAt == request.time
        && (
          // (a) Edit Kata (Milestone 8): topics only.
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['topics', 'updatedAt'])
            && request.resource.data.topics is list)
          ||
          // (b) Append a new meaning (Milestone 5).
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meanings', 'posList', 'updatedAt'])
            && request.resource.data.meanings is list
            && request.resource.data.meanings.size() > 0
            && request.resource.data.posList is list)
        );

      allow delete: if false;
    }

    // Milestone 4 Stage 2 / Milestone 5 (DATA_MODEL.md §2b): canonical
    // topic list. Read-only for any signed-in user; guru may create a new
    // topic (the "tambah topik baru" flow, §2b) — never update/delete
    // one, since nothing in the docs calls for renaming/removing topics.
    match /topics/{topicId} {
      allow read: if request.auth != null;

      allow create: if isGuru()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt']);

      allow update, delete: if false;
    }

    // Milestone 6 / Milestone 8 (`DATA_MODEL.md` §5, `SPEC.md` §4.1):
    // Read-only for any signed-in user.
    // Write: guru only, create only — authenticated teacher creating a set
    // with exact required fields, non-empty wordIds, valid timestamps,
    // targetStudentIds containing at least kAllStudents, and createdAt == request.time.
    // Update and delete are explicitly denied per Milestone 8 decision.
    match /targetWordSets/{setId} {
      allow read: if request.auth != null;

      allow create: if isGuru()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.wordIds is list
        && request.resource.data.wordIds.size() > 0
        && request.resource.data.cefrLevel is string
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.targetStudentIds is list
        && request.resource.data.targetStudentIds.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
             'teacherId', 'wordIds', 'cefrLevel', 'startAt', 'endAt',
             'targetStudentIds', 'createdAt'
           ]);

      allow update, delete: if false;
    }

    // Milestone 6 (`DATA_MODEL.md` §3/§4): Riwayat read paths. Both
    // collections are owned per-document by `studentId` — read is
    // restricted to that student, unlike `vocabWords`/`topics`/
    // `targetWordSets` above (there's no reason a *different* student
    // should ever read another's progress/session history).
    //
    // Milestone 7: real write rules, matching
    // `LearningProgressService`/`LearningSessionService`'s actual write
    // shapes exactly (`DATA_MODEL.md` §3/§4). No per-element array/map
    // iteration anywhere (`CLAUDE.md` §6) — every check below is a
    // whole-field type/size/equality check, never a per-entry one.
    match /learningProgress/{docId} {
      // Milestone 7 Phase 2 Stage 5 fix: ownership is checked via the
      // `docId`'s own `{studentId}_` prefix, not `resource.data.studentId`.
      // The latter dereferences `resource.data`, and `resource` is `null`
      // when the target document doesn't exist yet — which is exactly the
      // case every time a student learns a word for the very first time
      // (`LearningProgressService.recordClozeCompletion`'s read-then-
      // create-if-absent transaction always reads the doc before knowing
      // whether it exists). Dereferencing `.data` on a `null` `resource`
      // throws during rule evaluation, and Firestore denies the whole
      // request as `permission-denied` rather than treating it as "not
      // found" — this was blocking Fase 2→3 completion for every
      // first-time word (Milestone 7 Phase 2 diagnostic report, Bug 2).
      //
      // `docId.split('_')[0]` always yields exactly the `studentId`
      // segment, regardless of what `wordId` contains — a Firebase Auth
      // uid never itself contains `_`, so the first split segment is
      // always the whole uid, and everything after the first `_` is the
      // rest of the docId (the create rule below is what actually
      // enforces `docId == studentId + '_' + wordId` in the first place).
      // For any document that was ever validly created this is exactly
      // equivalent to `resource.data.studentId == request.auth.uid` — not
      // a weaker check, just one that also works before the document
      // exists, and one that never touches `resource` at all.
      //
      // Milestone 7 Phase 2 Stage 6 fix: that docId-only condition broke
      // `LearningProgressService.fetchForStudent`'s `.where('studentId',
      // isEqualTo: ...)` query (Riwayat "Per Kata") — Firestore can only
      // allow a `list`/query request when it can *statically* prove every
      // possible result satisfies the rule by matching the rule's
      // condition against the query's own `where()` clause, and it can
      // only do that for a condition on `resource.data`, never one
      // derived from `docId`. The two access patterns need different,
      // OR'd conditions: the first branch below is what makes the
      // single-document `get()`/transaction case above work (never
      // touches `resource`); the second is the original `resource.data`
      // condition, restored so Firestore can once again statically verify
      // it against `fetchForStudent`'s query. `||` short-circuits, so a
      // legitimate owner's single-document read never evaluates the
      // second branch (avoiding the original null-`resource` failure),
      // while the query path is satisfied by the second branch exactly as
      // it was before Stage 5. Neither branch is broader than "this is my
      // own document" — this is not a weaker rule, just two equivalent
      // expressions of the same ownership check, each usable by a
      // different Firestore operation.
      allow read: if request.auth != null
        && (
          docId.split('_')[0] == request.auth.uid
          || resource.data.studentId == request.auth.uid
        );

      // `docId` must be exactly `{studentId}_{wordId}` (`DATA_MODEL.md`
      // §3) — checked here, not trusted from the client, so a doc can
      // never be created under a mismatched id.
      //
      // `masteryStatus` always starts `difficult` on `create`
      // (`LearningProgressService.recordClozeCompletion`'s
      // `newLearnedData` — `DATA_MODEL.md` §3 rule 1: a word is never
      // created already `mastered`, that only ever happens via a later
      // `update`).
      allow create: if isOwner(request.resource.data.studentId)
        && docId == request.resource.data.studentId + '_' + request.resource.data.wordId
        && request.resource.data.wordId is string
        && request.resource.data.wordId.size() > 0
        && request.resource.data.learnedStatus == 'sudahDipelajari'
        && request.resource.data.masteryStatus == 'difficult'
        && request.resource.data.firstLearnedAt == request.time
        && request.resource.data.lastUpdatedAt == request.time
        && request.resource.data.lastSessionId is string
        && request.resource.data.lastSessionId.size() > 0
        && request.resource.data.keys().hasOnly([
             'studentId', 'wordId', 'learnedStatus', 'masteryStatus',
             'firstLearnedAt', 'lastUpdatedAt', 'lastSessionId'
           ]);

      // `studentId`/`wordId`/`learnedStatus`/`firstLearnedAt` are
      // immutable once created — only `lastUpdatedAt`/`lastSessionId`
      // (bookkeeping, every touch) and `masteryStatus` (only on an
      // actual upgrade) may ever change. The last clause is
      // `DATA_MODEL.md` §3 rule 3's permanence rule, enforced here as
      // well as in `utils/mastery_rules.dart`: once `mastered`, a write
      // that tries to set anything else is rejected outright.
      allow update: if isOwner(resource.data.studentId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastUpdatedAt', 'lastSessionId', 'masteryStatus'])
        && request.resource.data.lastUpdatedAt == request.time
        && request.resource.data.lastSessionId is string
        && request.resource.data.lastSessionId.size() > 0
        && request.resource.data.masteryStatus in ['difficult', 'mastered']
        && !(resource.data.masteryStatus == 'mastered'
             && request.resource.data.masteryStatus != 'mastered');

      allow delete: if false;
    }

    match /learningSessions/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.studentId;

      // First write of a session — Fase 1's first successful generate
      // (`DATA_MODEL.md` §4). Always starts at `currentPhase: membaca`
      // with every later-phase field at its empty/`null` default —
      // nothing can ever create a session that starts mid-flow.
      allow create: if isOwner(request.resource.data.studentId)
        && request.resource.data.wordIds is list
        && request.resource.data.wordIds.size() > 0
        && request.resource.data.sourceType in
             ['keranjangPelajari', 'targetGuru', 'pelajariUlangDifficult']
        && request.resource.data.currentPhase == 'membaca'
        && request.resource.data.storyTitle is string
        && request.resource.data.storyContent is string
        && request.resource.data.storyContent.size() > 0
        && request.resource.data.clozeTestResult == {}
        && request.resource.data.cowriteTranscript == []
        && request.resource.data.cowriteWordsUsedCorrectly == []
        && request.resource.data.startedAt == request.time
        && request.resource.data.completedAt == null
        && request.resource.data.keys().hasOnly([
             'studentId', 'wordIds', 'sourceType', 'currentPhase', 'storyTitle',
             'storyContent', 'storyTranslation', 'clozeTestResult',
             'cowriteTranscript', 'cowriteWordsUsedCorrectly', 'startedAt', 'completedAt'
           ]);

      // Five, and only five, update shapes exist — one per write this
      // app's services actually perform. `studentId`/`wordIds`/
      // `sourceType`/`startedAt` are never in any of them, i.e.
      // immutable for the life of the document.
      allow update: if isOwner(resource.data.studentId) && (
        // (a) Fase 1 "Generate ulang" — only while still `membaca`
        // (`DATA_MODEL.md` §4: story fields "ditimpa langsung" only
        // during that phase).
        (resource.data.currentPhase == 'membaca'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['storyTitle', 'storyContent', 'storyTranslation'])
          && request.resource.data.storyContent is string
          && request.resource.data.storyContent.size() > 0)
        ||
        // (b) Fase 1 → Fase 2 "Selanjutnya" — locks the story by moving
        // the phase forward only; no story field changes here.
        (resource.data.currentPhase == 'membaca'
          && request.resource.data.currentPhase == 'clozeTest'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPhase']))
        ||
        // (c) Fase 2 → Fase 3 — final `clozeTestResult` + phase together
        // (`DATA_MODEL.md` §4: write the whole map at once).
        (resource.data.currentPhase == 'clozeTest'
          && request.resource.data.currentPhase == 'coWrite'
          && request.resource.data.clozeTestResult is map
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['clozeTestResult', 'currentPhase']))
        ||
        // (d) Fase 3 — transcript saved after every turn, phase
        // unchanged.
        (resource.data.currentPhase == 'coWrite'
          && request.resource.data.cowriteTranscript is list
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['cowriteTranscript']))
        ||
        // (e) Fase 3 → `selesai` — the session's final write.
        (resource.data.currentPhase == 'coWrite'
          && request.resource.data.currentPhase == 'selesai'
          && request.resource.data.cowriteTranscript is list
          && request.resource.data.cowriteWordsUsedCorrectly is list
          && request.resource.data.completedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'cowriteTranscript', 'cowriteWordsUsedCorrectly', 'currentPhase', 'completedAt'
             ]))
      );

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Placement Test PT-V1.1 (`DATA_MODEL.md` §6). Tested against the local
    // Firestore Emulator (`tools/research`, `npm run test:rules`); deployment
    // status: `HANDOFF.md`.
    //
    // Trust model (Spark plan, no Cloud Functions, no Worker involvement):
    // - The answer key lives ONLY in `placementKey/{version}`, which no
    //   client can read or write; rules read it through get(), which is not
    //   subject to read rules. The app bundles items and options only.
    // - `placementAttempts/{uid}_{context}_{n}` (context `research` or
    //   `learning`): the student creates it with a per-band shuffled order,
    //   saves/changes one answer per write while `in_progress`, then submits
    //   once all 50 items are answered (`submitted`, frozen).
    // - Scoring is done HERE: the client proposes a result (level, A1*
    //   flag, target band) and the rules recompute the K2 decision from the
    //   frozen answers and the key; only the exact result is accepted
    //   (`scored`), once, in the same batch as `users.resultLevel` and — for
    //   a research attempt — the participant's band (or C1 exclusion).
    //   Band scores and quality flags are never stored; the researcher
    //   derives them offline from the frozen answers.
    // - Research writes need the participant to be awaiting placement, the
    //   attempt number the researcher authorized, no pending review, an
    //   active study and an open `placement` stage window (server time).
    //   A submission accepted before closure may be scored after it.
    // ---------------------------------------------------------------------

    function placementConfig() {
      return get(/databases/$(database)/documents/placementConfig/current).data;
    }

    function researchStudy() {
      return get(/databases/$(database)/documents/researchStudy/current).data;
    }

    // Stage window: active study and openAt <= request.time < closeAt.
    // A missing window (never opened) fails closed.
    function researchStageOpen(stage) {
      let s = researchStudy();
      let w = s.stages.get(stage, null);
      return s.status == 'active' && w != null
        && w.openAt is timestamp && w.closeAt is timestamp
        && w.openAt <= request.time && request.time < w.closeAt;
    }

    function participantPath(uid) {
      return /databases/$(database)/documents/researchParticipants/$(uid);
    }

    function placementAttemptPath(id) {
      return /databases/$(database)/documents/placementAttempts/$(id);
    }

    function placementBands() {
      return ['A1', 'A2', 'B1', 'B2', 'C1'];
    }

    // Exactly the bank's 50 items, band order fixed, shuffled within band.
    function validPlacementItemOrder(io, b) {
      return io is list && io.size() == 50 && io.toSet().size() == 50
        && io[0:10].toSet() == b.A1.toSet() && io[10:20].toSet() == b.A2.toSet()
        && io[20:30].toSet() == b.B1.toSet() && io[30:40].toSet() == b.B2.toSet()
        && io[40:50].toSet() == b.C1.toSet();
    }

    // Correct answers in one band: answers equal to the band's key entries.
    function placementBandScore(answers, bandKey) {
      return answers.diff(bandKey).unchangedKeys().size();
    }

    function atSix(s) {
      return s == 6 ? 1 : 0;
    }

    // K2 (researcher-selected, not expert-validated — `DATA_MODEL.md` §6):
    // band k when s[k] >= 7, every lower band >= 6 and at most one lower
    // band exactly 6; the highest such band; -1 = none (A1*). Mirrors
    // `tools/research/lib/placement/scoring.js` (tested against it).
    function placementK2(s0, s1, s2, s3, s4) {
      return (s4 >= 7 && s0 >= 6 && s1 >= 6 && s2 >= 6 && s3 >= 6
               && atSix(s0) + atSix(s1) + atSix(s2) + atSix(s3) <= 1) ? 4
        : (s3 >= 7 && s0 >= 6 && s1 >= 6 && s2 >= 6 && atSix(s0) + atSix(s1) + atSix(s2) <= 1) ? 3
        : (s2 >= 7 && s0 >= 6 && s1 >= 6 && atSix(s0) + atSix(s1) <= 1) ? 2
        : (s1 >= 7 && s0 >= 6) ? 1
        : (s0 >= 7) ? 0
        : -1;
    }

    function placementLevelIndex(answers, key) {
      return placementK2(placementBandScore(answers, key.A1), placementBandScore(answers, key.A2),
                         placementBandScore(answers, key.B1), placementBandScore(answers, key.B2),
                         placementBandScore(answers, key.C1));
    }

    // The proposed result equals the decision for level index [idx].
    function placementResultMatches(r, idx) {
      return (idx == -1 && r.resultLevel == 'A1' && r.belowA1Threshold == true && r.pretestTargetBand == 'A2')
        || (idx >= 0 && r.belowA1Threshold == false && r.resultLevel == placementBands()[idx]
            && r.pretestTargetBand == (idx == 4 ? null : placementBands()[idx + 1]));
    }

    function placementReviewPending(p) {
      return p.get('reviewStatus', null) == 'pending';
    }

    // Research writes on attempt [a]: participant awaiting placement, this
    // attempt number authorized, no pending review, window open.
    function researchPlacementWritable(a) {
      let p = researchParticipant();
      return p.status == 'awaiting_placement'
        && p.authorizedAttempts.placement == a.attemptNumber
        && !placementReviewPending(p)
        && researchStageOpen('placement');
    }

    // Ordinary (learning-only) placement: open to non-participants, to
    // participants excluded from the study, and to everyone once the study
    // is closed. Never touches research records.
    function learningPlacementAllowed() {
      return placementConfig().learningOpen == true
        && (!exists(participantPath(request.auth.uid))
          || researchParticipant().status == 'excluded'
          || researchStudy().status == 'closed');
    }

    function placementAttemptWritable(a) {
      return a.context == 'research' ? researchPlacementWritable(a) : learningPlacementAllowed();
    }

    // Learning attempt n > 1 only after attempt n − 1 was scored more than a
    // day ago (or voided): limits using the level as an answer oracle.
    function previousLearningAttemptDone(n) {
      let prev = get(placementAttemptPath(request.auth.uid + '_learning_' + string(n - 1))).data;
      return prev.status == 'voided'
        || (prev.status == 'scored' && request.time > prev.scoredAt + duration.value(1, 'd'));
    }

    function validPlacementAttemptCreate(attemptId) {
      let d = request.resource.data;
      let uid = request.auth.uid;
      let fields = ['studentId', 'context', 'attemptNumber', 'instrumentVersion', 'itemOrder',
                    'answers', 'lastAnsweredItemId', 'tabSwitchCount', 'status', 'startedAt', 'updatedAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.studentId == uid
        && d.attemptNumber is int && d.attemptNumber >= 1
        && d.status == 'in_progress'
        && d.answers == {}
        && d.lastAnsweredItemId == null
        && d.tabSwitchCount == 0
        && d.startedAt == request.time
        && d.updatedAt == request.time
        && d.instrumentVersion == placementConfig().instrumentVersion
        && validPlacementItemOrder(d.itemOrder,
             get(/databases/$(database)/documents/placementInstrument/$(d.instrumentVersion)).data.bandItems)
        && ((d.context == 'research'
              && attemptId == uid + '_research_' + string(d.attemptNumber)
              && researchPlacementWritable(d))
          || (d.context == 'learning'
              && attemptId == uid + '_learning_' + string(d.attemptNumber)
              && learningPlacementAllowed()
              && (d.attemptNumber == 1 || previousLearningAttemptDone(d.attemptNumber))));
    }

    // Save or change one answer (A–E) while in progress.
    function validPlacementAnswer() {
      let before = resource.data;
      let after = request.resource.data;
      let item = after.lastAnsweredItemId;
      return after.diff(before).affectedKeys().hasOnly(['answers', 'lastAnsweredItemId', 'updatedAt'])
        && after.updatedAt == request.time
        && item is string && item in before.itemOrder
        && after.answers.diff(before.answers).affectedKeys().hasOnly([item])
        && after.answers[item] in ['A', 'B', 'C', 'D', 'E'];
    }

    // Lifecycle signal (hidden/inactive) — recorded only, never acted on.
    function validPlacementTabSwitch() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['tabSwitchCount', 'updatedAt'])
        && after.updatedAt == request.time
        && after.tabSwitchCount == before.tabSwitchCount + 1;
    }

    // Submit: only with all 50 items answered; freezes the answers.
    function validPlacementSubmit() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['status', 'submittedAt', 'updatedAt'])
        && after.status == 'submitted'
        && after.submittedAt == request.time
        && after.updatedAt == request.time
        && before.answers.size() == 50
        && before.answers.keys().hasOnly(before.itemOrder);
    }

    // Score: once, on a submitted attempt, with exactly the K2 result,
    // together with users.resultLevel (and the participant band for a
    // research attempt) in the same batch. No window check: a submission
    // accepted before closure may be scored after it.
    function validPlacementScore(attemptId) {
      let before = resource.data;
      let after = request.resource.data;
      let key = get(/databases/$(database)/documents/placementKey/$(before.instrumentVersion)).data.key;
      return after.diff(before).affectedKeys().hasOnly(
               ['status', 'resultLevel', 'belowA1Threshold', 'pretestTargetBand', 'scoringPolicy', 'scoredAt', 'updatedAt'])
        && after.status == 'scored'
        && after.scoredAt == request.time
        && after.updatedAt == request.time
        && after.scoringPolicy == 'K2'
        && placementResultMatches(after, placementLevelIndex(before.answers, key))
        && getAfter(/databases/$(database)/documents/users/$(before.studentId)).data.resultAttemptId == attemptId
        && (before.context == 'learning'
          || getAfter(participantPath(before.studentId)).data.placementAttemptId == attemptId);
    }

    match /placementConfig/{docId} {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    match /researchStudy/{docId} {
      allow get: if request.auth != null;
      // The Researcher Panel opens/closes one stage window per write
      // (`validOperatorStudyWrite`, below); study status stays tooling-only.
      allow update: if docId == 'current' && isResearchOperator() && validOperatorStudyWrite();
      allow list, create, delete: if false;
    }

    // Trusted-tooling only. The key document is never readable by clients.
    match /placementInstrument/{docId} {
      allow read, write: if false;
    }
    match /placementKey/{docId} {
      allow read, write: if false;
    }
    match /researchReviews/{docId} {
      allow read, write: if false;
    }

    match /placementAttempts/{attemptId} {
      // Own attempts only (get, and list queries constrained to studentId).
      allow read: if request.auth != null && resource.data.studentId == request.auth.uid;

      allow create: if request.auth != null && validPlacementAttemptCreate(attemptId);

      allow update: if request.auth != null
        && resource.data.studentId == request.auth.uid
        && ((resource.data.status == 'in_progress'
              && placementAttemptWritable(resource.data)
              && (validPlacementAnswer() || validPlacementTabSwitch() || validPlacementSubmit()))
          || (resource.data.status == 'submitted' && validPlacementScore(attemptId)));

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // Research pretest/posttest (research Milestone 2a, `DATA_MODEL.md`
    // §6b). Tested against the local Firestore Emulator (`tools/research`,
    // `npm run test:rules`); deployment status: `HANDOFF.md`.
    //
    // Trust model (Spark plan, no Cloud Functions):
    // - `researchParticipants/{uid}` is written ONLY by researcher-controlled
    //   Admin SDK tooling (which bypasses these rules). It holds the
    //   research band and the explicit per-stage authorization
    //   `authorizedAttempts: {preTest: int, postTest: int}` (0 = not
    //   authorized; n = attempt n may be created). Clients can read their
    //   own record; their only write is the automatic placement band
    //   (`validPlacementBandWrite`, recomputed by these rules), so nobody
    //   can pick their band or authorize themselves. The single researcher
    //   operator may additionally authorize / retake through the Researcher
    //   Panel (`validOperatorParticipantWrite`, below). A participant may be
    //   enrolled without a band (`status: awaiting_placement`); pretest and
    //   posttest additionally need a band, `status: enrolled`, no pending
    //   review and an open stage window (`researchStudy/current`).
    //   `users.cefrLevel` / `users.resultLevel` are never consulted.
    // - `researchAssessmentResults/{uid}_{stage}_{n}` is one attempt. The
    //   student creates it (fixed question/option order), then adds one
    //   answer per write (never changing a saved answer), then completes it
    //   once all 20 answers exist. `voided` (technical interruption) is set
    //   only by trusted tooling, which also raises `authorizedAttempts` for
    //   a retake; the old attempt and its answers are kept untouched.
    // - Option IDs and texts are checked against the bank's PUBLIC data in
    //   `researchInstrument/{version}_{band}` (trusted-tooling only; no
    //   answer key, no correctness information).
    // - Never stored here: answer key, correctness, per-item codes, scores.
    // ---------------------------------------------------------------------

    function researchParticipant() {
      return get(/databases/$(database)/documents/researchParticipants/$(request.auth.uid)).data;
    }

    function researchAttemptId(stage, n) {
      return request.auth.uid + '_' + stage + '_' + string(n);
    }

    // Public instrument-bank data for one version + band, written only by
    // trusted tooling from `assets/research/instrument_v1.json`:
    //   researchInstrument/{version}_{band} = {
    //     optionIds:   {itemId: [4 option IDs]},
    //     optionTexts: {itemId: {optionId: text}} }
    // No answer key, no correctness information. Read through get() (one
    // cached document read per request) rather than embedded as rule
    // literals, because large literals exceed Firestore's 1000-expression
    // per-request limit. A missing document makes every create/answer fail
    // closed.
    function researchInstrument(version, band) {
      return get(/databases/$(database)/documents/researchInstrument/$(version + '_' + band)).data;
    }

    // Exactly the band's 20 bank items, each once.
    function validResearchItemOrder(io, ids) {
      return io is list && io.size() == 20 && io.toSet().size() == 20 && io.hasOnly(ids.keys());
    }

    // The 4 displayed options of item k: a permutation of the bank's 4
    // option IDs for that item ("Saya tidak tahu kata ini" is never listed:
    // it is always shown last and stored as 'dont_know').
    // No separate `is list` check: a non-list has no toSet() and fails
    // closed, and the saved expressions keep the create under the
    // 1000-expression limit now that it also checks the stage window and
    // eligibility.
    function validResearchOptions(oo, k, ids) {
      return oo[k].size() == 4 && oo[k].toSet() == ids[k].toSet();
    }

    // Written out per position because the rules language has no loops.
    function validResearchOptionOrder(oo, io, ids) {
      return oo is map && oo.size() == 20 && oo.keys().hasOnly(io)
        && validResearchOptions(oo, io[0], ids) && validResearchOptions(oo, io[1], ids)
        && validResearchOptions(oo, io[2], ids) && validResearchOptions(oo, io[3], ids)
        && validResearchOptions(oo, io[4], ids) && validResearchOptions(oo, io[5], ids)
        && validResearchOptions(oo, io[6], ids) && validResearchOptions(oo, io[7], ids)
        && validResearchOptions(oo, io[8], ids) && validResearchOptions(oo, io[9], ids)
        && validResearchOptions(oo, io[10], ids) && validResearchOptions(oo, io[11], ids)
        && validResearchOptions(oo, io[12], ids) && validResearchOptions(oo, io[13], ids)
        && validResearchOptions(oo, io[14], ids) && validResearchOptions(oo, io[15], ids)
        && validResearchOptions(oo, io[16], ids) && validResearchOptions(oo, io[17], ids)
        && validResearchOptions(oo, io[18], ids) && validResearchOptions(oo, io[19], ids);
    }

    // Exact-equality check against the caller's currently authorized attempt
    // IDs (`uid_stage_n`); fails closed when the caller has no participant
    // record.
    function isOwnAuthorizedResearchAttemptId(attemptId) {
      let a = researchParticipant().authorizedAttempts;
      return (a.preTest is int && a.preTest >= 1 && attemptId == researchAttemptId('preTest', a.preTest))
        || (a.postTest is int && a.postTest >= 1 && attemptId == researchAttemptId('postTest', a.postTest));
    }

    // Pretest/posttest need a research band and an enrolled participant
    // without a pending review. Records from the original enrolment tooling
    // (band assigned by the researcher, no `status`) count as enrolled.
    function researchParticipantActive(p) {
      return p.get('band', null) in ['A2', 'B1', 'B2', 'C1']
        && p.get('status', 'enrolled') == 'enrolled'
        && !placementReviewPending(p);
    }

    function researchPreTestCompleted(p) {
      return p.authorizedAttempts.preTest is int && p.authorizedAttempts.preTest >= 1
        && get(/databases/$(database)/documents/researchAssessmentResults/$(researchAttemptId('preTest', p.authorizedAttempts.preTest))).data.status == 'completed';
    }

    function validResearchAttemptCreate(attemptId) {
      let d = request.resource.data;
      let p = researchParticipant();
      let ids = researchInstrument(d.instrumentVersion, d.band).optionIds;
      let fields = ['studentId', 'stage', 'attemptNumber', 'band', 'instrumentVersion',
                    'itemOrder', 'optionOrder', 'responses', 'lastAnsweredItemId',
                    'status', 'startedAt', 'updatedAt', 'completedAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.studentId == request.auth.uid
        && d.stage in ['preTest', 'postTest']
        && d.attemptNumber is int && d.attemptNumber >= 1
        && attemptId == researchAttemptId(d.stage, d.attemptNumber)
        && p.authorizedAttempts[d.stage] == d.attemptNumber
        && d.band in ['A2', 'B1', 'B2', 'C1'] && d.band == p.band
        && d.instrumentVersion == p.instrumentVersion
        && d.status == 'in_progress'
        && d.responses == {}
        && d.lastAnsweredItemId == null
        && d.completedAt == null
        && d.startedAt == request.time
        && d.updatedAt == request.time
        && validResearchItemOrder(d.itemOrder, ids)
        && validResearchOptionOrder(d.optionOrder, d.itemOrder, ids)
        && researchParticipantActive(p)
        && researchStageOpen(d.stage)
        && (d.stage == 'preTest' || researchPreTestCompleted(p));
    }

    // One saved answer: the chosen displayed option (or 'dont_know', always
    // position 5), its exact bank text, and a server timestamp.
    function validResearchAnswer(r, item, oo, texts) {
      let fields = ['optionId', 'optionText', 'displayPosition', 'answeredAt'];
      return r is map && r.keys().hasOnly(fields) && r.keys().hasAll(fields)
        && r.answeredAt == request.time
        && r.displayPosition is int
        && ((r.optionId == 'dont_know'
              && r.displayPosition == 5
              && r.optionText == 'Saya tidak tahu kata ini')
          || (r.optionId is string && r.optionId in oo[item]
              && r.optionText == texts[item][r.optionId]
              && ((r.displayPosition == 1 && oo[item][0] == r.optionId)
                || (r.displayPosition == 2 && oo[item][1] == r.optionId)
                || (r.displayPosition == 3 && oo[item][2] == r.optionId)
                || (r.displayPosition == 4 && oo[item][3] == r.optionId))));
    }

    // Exactly one new answer, for an item of this attempt that has no saved
    // answer yet (forward-only: a saved answer can never be changed).
    function validResearchAnswerWrite() {
      let before = resource.data;
      let after = request.resource.data;
      let item = after.lastAnsweredItemId;
      return after.diff(before).affectedKeys().hasOnly(['responses', 'lastAnsweredItemId', 'updatedAt'])
        && after.updatedAt == request.time
        && item is string
        && item in before.itemOrder
        && !(item in before.responses)
        && after.responses.diff(before.responses).affectedKeys().hasOnly([item])
        && item in after.responses
        && validResearchAnswer(after.responses[item], item, before.optionOrder,
                               researchInstrument(before.instrumentVersion, before.band).optionTexts);
    }

    // Completion: only once all 20 items have a saved answer.
    function validResearchCompletion() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt'])
        && after.status == 'completed'
        && after.completedAt == request.time
        && after.updatedAt == request.time
        && before.responses.size() == 20
        && before.responses.keys().hasOnly(before.itemOrder);
    }

    // The ONLY client write to a participant record: the automatic band (or
    // C1 exclusion) from the participant's currently authorized research
    // placement attempt, scored in this same batch, while still awaiting
    // placement with no band and no pending review.
    function validPlacementBandWrite(uid) {
      let before = resource.data;
      let after = request.resource.data;
      let id = uid + '_research_' + string(before.authorizedAttempts.placement);
      let a = getAfter(placementAttemptPath(id)).data;
      return before.status == 'awaiting_placement' && before.band == null
        && !placementReviewPending(before)
        && after.diff(before).affectedKeys().hasOnly(
             ['band', 'bandSource', 'status', 'exclusionReason', 'placementAttemptId', 'updatedAt'])
        && after.placementAttemptId == id
        && after.updatedAt == request.time
        && a.studentId == uid && a.status == 'scored' && a.scoredAt == request.time
        && ((a.pretestTargetBand != null
              && after.band == a.pretestTargetBand && after.bandSource == 'placement_test'
              && after.status == 'enrolled' && after.exclusionReason == null)
          || (a.pretestTargetBand == null && a.resultLevel == 'C1'
              && after.band == null && after.bandSource == null
              && after.status == 'excluded' && after.exclusionReason == 'placement_c1'));
    }

    // ---------------------------------------------------------------------
    // Researcher Panel (`DATA_MODEL.md` §6d). The single researcher operator
    // signs in with their ordinary guru account; `researchOperators/{uid}`
    // (`active: true`) is written ONLY by trusted tooling
    // (`research_admin.js operator --grant`), never by any client, so no
    // account can promote itself. Every operator write is narrow (one
    // stage window, one authorization step, one technical void) and must
    // create its `researchAuditLog` entry in the same batch: the entry's ID
    // is derived from the change itself, so each change has exactly one
    // entry and an entry cannot exist without its change. Bands, study
    // status, enrolment, reviews, keys and banks stay tooling-only. The
    // operator never reads attempt documents (they hold the answers): the
    // panel reads `researchProgress`, a counts-and-status mirror that the
    // rules check against the attempt.
    // ---------------------------------------------------------------------

    function isResearchOperator() {
      return request.auth != null
        && get(/databases/$(database)/documents/researchOperators/$(request.auth.uid)).data.active == true;
    }

    function auditPath(id) {
      return /databases/$(database)/documents/researchAuditLog/$(id);
    }

    function resultPath(id) {
      return /databases/$(database)/documents/researchAssessmentResults/$(id);
    }

    function windowOpenAt(w, t) {
      return w != null && w.openAt is timestamp && w.closeAt is timestamp
        && w.openAt <= t && t < w.closeAt;
    }

    // Open (openAt = now, closeAt in the future) or close (closeAt = now,
    // openAt kept) exactly one stage window [s] of an active study.
    function operatorWindowWrite(before, after, s) {
      let w0 = before.stages.get(s, null);
      let w1 = after.stages.get(s, null);
      return after.stages.diff(before.stages).affectedKeys().hasOnly([s])
        && w1 is map && w1.keys().hasOnly(['openAt', 'closeAt'])
        && ((!windowOpenAt(w0, request.time)
              && w1.openAt == request.time && w1.closeAt is timestamp && w1.closeAt > request.time)
          || (windowOpenAt(w0, request.time)
              && w1.openAt == w0.openAt && w1.closeAt == request.time));
    }

    function validOperatorStudyWrite() {
      let before = resource.data;
      let after = request.resource.data;
      let seq = before.get('operatorSeq', 0) + 1;
      return before.status == 'active'
        && after.diff(before).affectedKeys().hasOnly(['stages', 'updatedAt', 'operatorSeq'])
        && after.operatorSeq == seq
        && after.updatedAt == request.time
        && (operatorWindowWrite(before, after, 'placement')
          || operatorWindowWrite(before, after, 'preTest')
          || operatorWindowWrite(before, after, 'postTest'))
        && existsAfter(auditPath('study_' + string(seq)));
    }

    // First authorization (0 → 1) of pretest or posttest [s] for [uid]:
    // active participant with a band, seeded bank, and — for the posttest —
    // a completed pretest. The session-4 attestation and the placement-band
    // acknowledgement are recorded (and checked) in the audit entry.
    function operatorAuthorize(uid, s) {
      let before = resource.data;
      let a0 = before.authorizedAttempts;
      let a1 = request.resource.data.authorizedAttempts;
      return a1.diff(a0).affectedKeys().hasOnly([s])
        && a0.get(s, 0) == 0 && a1[s] == 1
        && researchParticipantActive(before)
        && exists(/databases/$(database)/documents/researchInstrument/$(before.instrumentVersion + '_' + before.band))
        && (s == 'preTest'
          || (a0.preTest is int && a0.preTest >= 1
            && get(resultPath(uid + '_preTest_' + string(a0.preTest))).data.status == 'completed'))
        && existsAfter(auditPath('authorize_' + s + '_' + uid + '_1'));
    }

    // Retake (n → n + 1) after attempt n of [s] is voided (now or earlier).
    // A pretest retake is refused once the posttest is authorized.
    function operatorRetake(uid, s) {
      let before = resource.data;
      let a0 = before.authorizedAttempts;
      let a1 = request.resource.data.authorizedAttempts;
      return a1.diff(a0).affectedKeys().hasOnly([s])
        && a0.get(s, 0) is int && a0.get(s, 0) >= 1 && a1[s] == a0[s] + 1
        && (s == 'postTest' || a0.get('postTest', 0) == 0)
        && researchParticipantActive(before)
        && getAfter(resultPath(uid + '_' + s + '_' + string(a0[s]))).data.status == 'voided'
        && existsAfter(auditPath('retake_' + s + '_' + uid + '_' + string(a1[s])));
    }

    function validOperatorParticipantWrite(uid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorizedAttempts', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (operatorAuthorize(uid, 'preTest') || operatorAuthorize(uid, 'postTest')
          || operatorRetake(uid, 'preTest') || operatorRetake(uid, 'postTest'));
    }

    // Technical void of the currently authorized, unfinished attempt. Every
    // answer is kept; the reason is a fixed code, never free text.
    function validOperatorVoid(attemptId) {
      let before = resource.data;
      let after = request.resource.data;
      let p = get(participantPath(before.studentId)).data;
      return before.status == 'in_progress'
        && after.diff(before).affectedKeys().hasOnly(['status', 'voidReason', 'voidedAt'])
        && after.status == 'voided'
        && after.voidReason == 'technical_interruption'
        && after.voidedAt == request.time
        && p.authorizedAttempts[before.stage] == before.attemptNumber
        && (before.stage == 'postTest' || p.authorizedAttempts.postTest == 0)
        && existsAfter(auditPath('void_' + attemptId));
    }

    // `researchProgress/{attemptId}` mirrors attempt [a] exactly: owner,
    // number, status and the number of saved answers — never the answers.
    // Tooling keeps it in step when it voids or restores an attempt.
    function progressMirrors(id, a, uid) {
      let d = request.resource.data;
      let fields = ['studentId', 'stage', 'attemptNumber', 'answered', 'total', 'status', 'updatedAt'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.studentId == uid && a.studentId == uid
        && d.attemptNumber == a.attemptNumber
        && d.status == a.status
        && d.updatedAt == request.time
        && ((d.stage == 'placement' && a.context == 'research'
              && id == uid + '_research_' + string(a.attemptNumber)
              && d.total == 50 && d.answered == a.answers.size())
          || (d.stage in ['preTest', 'postTest'] && d.stage == a.stage
              && id == uid + '_' + d.stage + '_' + string(a.attemptNumber)
              && d.total == 20 && d.answered == a.responses.size()));
    }

    function progressAttemptPath(id, stage) {
      return stage == 'placement' ? placementAttemptPath(id) : resultPath(id);
    }

    // Audit entry: the operator, the server time, and the change it
    // describes — which must be part of this same batch.
    function validAuditEntry(id) {
      let d = request.resource.data;
      let fields = ['action', 'stage', 'targetUid', 'attemptNumber', 'seq', 'operatorUid', 'at',
                    'session4Confirmed', 'placementPolicyAcknowledged', 'reason'];
      return d.keys().hasOnly(fields) && d.keys().hasAll(fields)
        && d.operatorUid == request.auth.uid
        && d.at == request.time
        && ((d.action in ['open_stage', 'close_stage']
              && d.stage in ['placement', 'preTest', 'postTest']
              && d.seq is int && id == 'study_' + string(d.seq)
              && d.targetUid == null && d.attemptNumber == null && d.reason == null
              && d.session4Confirmed == false && d.placementPolicyAcknowledged == false
              && getAfter(/databases/$(database)/documents/researchStudy/current).data.operatorSeq == d.seq
              && (d.action == 'open_stage'
                ? getAfter(/databases/$(database)/documents/researchStudy/current).data.stages[d.stage].openAt == request.time
                : getAfter(/databases/$(database)/documents/researchStudy/current).data.stages[d.stage].closeAt == request.time))
          || (d.action == 'authorize'
              && d.stage in ['preTest', 'postTest'] && d.targetUid is string
              && d.attemptNumber == 1 && d.seq == null && d.reason == null
              && id == 'authorize_' + d.stage + '_' + d.targetUid + '_1'
              && getAfter(participantPath(d.targetUid)).data.authorizedAttempts[d.stage] == 1
              && d.session4Confirmed == (d.stage == 'postTest')
              && d.placementPolicyAcknowledged == (getAfter(participantPath(d.targetUid)).data.bandSource == 'placement_test'))
          || (d.action == 'retake'
              && d.stage in ['preTest', 'postTest'] && d.targetUid is string
              && d.attemptNumber is int && d.attemptNumber >= 2 && d.seq == null
              && d.reason == 'technical_interruption'
              && d.session4Confirmed == false && d.placementPolicyAcknowledged == false
              && id == 'retake_' + d.stage + '_' + d.targetUid + '_' + string(d.attemptNumber)
              && getAfter(participantPath(d.targetUid)).data.authorizedAttempts[d.stage] == d.attemptNumber)
          || (d.action == 'void'
              && d.stage in ['preTest', 'postTest'] && d.targetUid is string
              && d.attemptNumber is int && d.attemptNumber >= 1 && d.seq == null
              && d.reason == 'technical_interruption'
              && d.session4Confirmed == false && d.placementPolicyAcknowledged == false
              && id == 'void_' + d.targetUid + '_' + d.stage + '_' + string(d.attemptNumber)
              && getAfter(resultPath(d.targetUid + '_' + d.stage + '_' + string(d.attemptNumber))).data.status == 'voided'));
    }

    match /researchOperators/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Name + research ID per participant, written by `enrol`; operator only.
    match /researchRoster/{uid} {
      allow read: if isResearchOperator();
      allow write: if false;
    }

    match /researchProgress/{attemptId} {
      allow read: if isResearchOperator();
      // Written only by the attempt's own student, after each saved write
      // (best effort: a refused mirror never affects the attempt itself).
      allow create, update: if request.auth != null
        && request.resource.data.studentId == request.auth.uid
        && progressMirrors(attemptId,
             get(progressAttemptPath(attemptId, request.resource.data.stage)).data,
             request.auth.uid);
      allow delete: if false;
    }

    match /researchAuditLog/{logId} {
      allow read: if isResearchOperator();
      allow create: if isResearchOperator() && validAuditEntry(logId);
      allow update, delete: if false;
    }

    match /researchParticipants/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isResearchOperator());
      allow list: if isResearchOperator();
      allow update: if request.auth != null
        && ((request.auth.uid == uid && validPlacementBandWrite(uid))
          || (isResearchOperator() && validOperatorParticipantWrite(uid)));
      allow create, delete: if false;
    }

    // Trusted, read-only bank data used by the rules above. Clients never
    // need it (the app bundles the same public bank as an asset); get()
    // inside rules is not subject to these read rules.
    match /researchInstrument/{docId} {
      allow read, write: if false;
    }

    match /researchAssessmentResults/{attemptId} {
      // Own attempts only. An existing attempt is readable only by the UID
      // stored in it; a not-yet-created one only when its ID is EXACTLY one
      // of the caller's currently authorized attempt IDs (so the app can
      // check "is there an attempt to resume?"). No UID is ever used as a
      // regex or prefix (security audit 2026-10-24: a regex built from the
      // UID let a crafted UID such as 'stu.x' probe whether 'stuax' had an
      // attempt, and broke reads for UIDs with regex metacharacters).
      // No list queries.
      allow get: if request.auth != null
        && ((resource != null && resource.data.studentId == request.auth.uid)
          || (resource == null && isOwnAuthorizedResearchAttemptId(attemptId)));
      allow list: if false;

      allow create: if request.auth != null && validResearchAttemptCreate(attemptId);

      // Only while in progress, only on the attempt that is currently
      // authorized for this stage (a superseded attempt is frozen), and only
      // while the stage window is open (a closed window or study freezes it).
      allow update: if request.auth != null
        && ((resource.data.studentId == request.auth.uid
            && resource.data.status == 'in_progress'
            && researchParticipant().authorizedAttempts[resource.data.stage] == resource.data.attemptNumber
            && researchStageOpen(resource.data.stage)
            && (validResearchAnswerWrite() || validResearchCompletion()))
          || (isResearchOperator() && validOperatorVoid(attemptId)));

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
