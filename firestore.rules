rules_version = '2';

// Milestone 1 baseline: deny all client reads/writes by default.
//
// This intentionally does NOT model any application schema yet — no
// `users`/`vocabWords`/etc. rules exist because those collections don't
// exist yet either (see DATA_MODEL.md). Real, schema-aware rules are
// introduced starting Milestone 2 (users/role assignment) and expanded in
// Milestone 4/5 (vocabWords) per CLAUDE.md's build order.
//
// This baseline replaces the project's previous test-mode rules, which had
// already expired (2026-05-15) and were functioning as an accidental
// deny-all. This makes that state explicit and intentional instead.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
